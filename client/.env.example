# Base URL for REST API requests (leave empty to use same origin / Vite dev proxy)
VITE_API_URL=

# WebSocket URL for signaling server (leave empty to use same origin /ws)
VITE_WS_URL=

# Public STUN server URL for WebRTC NAT traversal and ICE candidate discovery
VITE_STUN_URL=stun:stun.l.google.com:19302

# Optional TURN relay server URL for restrictive symmetric NATs
VITE_TURN_URL=

# Username credential for the optional TURN relay server
VITE_TURN_USER=

# Password credential for the optional TURN relay server
VITE_TURN_PASS=
