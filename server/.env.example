# HTTP port for the Express REST API and WebSocket signaling server
PORT=5000

# MongoDB connection string for sessions, users, transfers, and devices
MONGO_URI=mongodb://localhost:27017/pelican

# Secret key used to sign and verify JSON Web Tokens (JWT) for authentication
JWT_SECRET=change_me_to_a_secure_random_string

# Allowed frontend origin for CORS and WebSocket verifyClient validation
CLIENT_ORIGIN=http://localhost:5173

# Time-to-live in minutes for transfer sessions before automatic expiration
SESSION_TTL_MINUTES=15
